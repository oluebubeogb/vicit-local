# ======================
# Vicit Llog
# ======================

POSTGRES_USER=vicit
POSTGRES_PASSWORD=vicit_secret_change_me
POSTGRES_DB=vicit_llog
DATABASE_URL=postgresql://vicit:vicit_secret_change_me@db:5432/vicit_llog?schema=public

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
PHOTO_STORAGE_PATH=/data/photos
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PORT=4000

NEXT_PUBLIC_API_URL=http://localhost:4000
# Public HTTPS URL of the API as seen from visitors' phones (used for the hosted QR image
# link in visitor emails). Falls back to NEXT_PUBLIC_API_URL; localhost URLs are skipped.
API_PUBLIC_URL=
NEXT_PUBLIC_APP_NAME=Vicit Llog
# Server-side URL the Next.js server uses to reach the API (dynamic PWA manifest reads
# Branding & Settings through it). In docker-compose this is http://backend:4000.
# Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# REQUIRED — only source of the deployment Super Admin login (no hardcoded defaults)
ADMIN_EMAIL=admin@yourorg.com
ADMIN_PASSWORD=ChangeMeNow!
ADMIN_NAME=System Administrator
ADMIN_PHONE=
ORGANIZATION=Your Organisation Name
ORGANIZATION_CODE=YOURORG
# Single agency = ORGANIZATION_CODE. SINGLE_AGENCY_CODE is optional (leave empty).
SINGLE_AGENCY_CODE=
# v32 paper-request hosts: log the SMS hook (no SMS is sent yet)
EXTERNAL_HOST_SMS=false

INVITE_LINK_TTL_MINUTES=60
PHOTO_RETENTION_DAYS=90

# ---- Web Push (VAPID) ----
# Optional: in-app alerts can also go out as Web Push (needs internet). Off by default.
# Generate a stable pair with: npx web-push generate-vapid-keys
# Leave the keys empty only for local experiments — the API will use ephemeral keys that die on restart.
# Set ENABLE_PUSH=true to turn delivery on. Default is off (intranet).
ENABLE_PUSH=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourorg.com

SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TERMII_API_KEY=
TERMII_SMS_FROM=VicitLlog
AT_USERNAME=
AT_API_KEY=
AT_SMS_FROM=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=


# Show temporary passwords in Admin UI (create / reset / bulk CSV). Default off.
# Emails are sent only when MAIL_ENABLED=true and SMTP is configured.
SHOW_TEMP_PASSWORDS_IN_ADMIN=false

# Mail is OFF by default on the intranet. Set MAIL_ENABLED=true (and SMTP_*) to send
# welcome / password-reset / host emails. Guests are never emailed.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vicit Llog <noreply@yourorg.com>"
# Optional (v19): bulk mail is sent over a pooled connection with retries.
# SMTP_RETRIES=3
# SMTP_RATE_PER_SECOND=3

# Optional (v19): visit reminders (1 day + 1 hour before). Defaults shown.
# REMINDERS_ENABLED=true
# REMINDER_INTERVAL_SECONDS=60

# Email header logo background (for transparent PNG icons)
EMAIL_ICON_BG=#ffffff
EMAIL_LOGO_URL=
EMAIL_BRAND_COLOR=#1e40af

# App timezone used for attendance calendar days and contractor validity.
APP_TIMEZONE=Africa/Lagos
